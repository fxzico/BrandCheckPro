{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.brandcheckpro.in" }],
      "destination": "https://brandcheckpro.in/:path*",
      "permanent": true
    },
    { "source": "/blog-seo-optimized.html", "destination": "/blog.html", "permanent": true },
    { "source": "/blog/index.html", "destination": "/blog.html", "permanent": true },
    { "source": "/blog/seo-optimized/:path*", "destination": "/blog.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/api/analyze",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
